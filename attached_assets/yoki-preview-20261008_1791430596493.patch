diff --git a/artifacts/mobile/components/village/ResidentMeal.tsx b/artifacts/mobile/components/village/ResidentMeal.tsx
new file mode 100644
index 0000000..25d5a2f
--- /dev/null
+++ b/artifacts/mobile/components/village/ResidentMeal.tsx
@@ -0,0 +1,136 @@
+import React from "react";
+import { View, StyleSheet } from "react-native";
+import Animated, {
+  useAnimatedStyle,
+  type SharedValue,
+} from "react-native-reanimated";
+import Svg, {
+  Defs,
+  Ellipse,
+  LinearGradient,
+  Path,
+  Stop,
+} from "react-native-svg";
+import {
+  BerryIcon,
+  AppleIcon,
+  CandyIcon,
+  CakeFoodIcon,
+  RamenIcon,
+  SpecialFoodIcon,
+} from "@/components/ui/Illustrations";
+import { mealSample } from "@/utils/residentMeal";
+function Food({ id, size }: { id: string; size: number }) {
+  const Art =
+    {
+      berry: BerryIcon,
+      apple: AppleIcon,
+      candy: CandyIcon,
+      cake: CakeFoodIcon,
+      ramen: RamenIcon,
+      special: SpecialFoodIcon,
+    }[id] ?? BerryIcon;
+  return <Art size={size} />;
+}
+function Portion({
+  index,
+  size,
+  food,
+  progress,
+}: {
+  index: number;
+  size: number;
+  food: string;
+  progress: SharedValue<number>;
+}) {
+  const style = useAnimatedStyle(() => ({
+    opacity: mealSample(progress.value).taken > index ? 0 : 1,
+  }));
+  return (
+    <Animated.View
+      testID={`meal-portion-${index}`}
+      style={[
+        {
+          position: "absolute",
+          left: size * (0.68 + index * 0.1),
+          top: size * 0.71,
+        },
+        style,
+      ]}
+    >
+      <Food id={food} size={size * 0.18} />
+    </Animated.View>
+  );
+}
+export function ResidentMeal({
+  size,
+  food,
+  progress,
+}: {
+  size: number;
+  food: string;
+  progress: SharedValue<number>;
+}) {
+  const morsel = useAnimatedStyle(() => {
+    const m = mealSample(progress.value);
+    return {
+      opacity: m.morsel,
+      transform: [
+        { translateX: size * (0.83 - 0.3 * m.flight) },
+        { translateY: size * (0.74 - 0.15 * m.flight) },
+        { scale: 1 - m.flight * 0.35 },
+      ],
+    };
+  });
+  return (
+    <View
+      testID="world-food-offering"
+      pointerEvents="none"
+      style={[StyleSheet.absoluteFill, { zIndex: 10 }]}
+    >
+      <Svg
+        width={size * 0.8}
+        height={size * 0.38}
+        style={{ position: "absolute", left: size * 0.5, top: size * 0.75 }}
+        viewBox="0 0 120 55"
+      >
+        <Defs>
+          <LinearGradient id="mealBowl" x1="0" y1="0" x2="0" y2="1">
+            <Stop stopColor="#FFF5DB" />
+            <Stop offset=".6" stopColor="#CEBFA3" />
+            <Stop offset="1" stopColor="#AB9273" />
+          </LinearGradient>
+        </Defs>
+        <Ellipse cx="60" cy="42" rx="50" ry="8" fill="#34291930" />
+        <Path
+          d="M 7 16 Q 9 47 60 47 Q 111 47 113 16 Z"
+          fill="url(#mealBowl)"
+          stroke="#AD9675"
+        />
+        <Ellipse
+          cx="60"
+          cy="16"
+          rx="53"
+          ry="13"
+          fill="#D5C5A5"
+          stroke="#F9EBD0"
+          strokeWidth="4"
+        />
+      </Svg>
+      {[0, 1, 2].map((i) => (
+        <Portion
+          key={i}
+          index={i}
+          size={size}
+          food={food}
+          progress={progress}
+        />
+      ))}
+      <Animated.View
+        testID="meal-morsel" style={[{ position: "absolute", left: 0, top: 0 }, morsel]}
+      >
+        <Food id={food} size={size * 0.18} />
+      </Animated.View>
+    </View>
+  );
+}
diff --git a/artifacts/mobile/components/village/VillageActors.tsx b/artifacts/mobile/components/village/VillageActors.tsx
new file mode 100644
index 0000000..7d0c8c2
--- /dev/null
+++ b/artifacts/mobile/components/village/VillageActors.tsx
@@ -0,0 +1,289 @@
+import React, { useEffect } from "react";
+import { Pressable, StyleSheet, Text, View } from "react-native";
+import Animated, {
+  cancelAnimation,
+  Easing,
+  useAnimatedStyle,
+  useSharedValue,
+  withDelay,
+  withRepeat,
+  withSequence,
+  withTiming,
+} from "react-native-reanimated";
+import Svg, { Ellipse, Path } from "react-native-svg";
+import { VolumeEgg } from "@/components/world/VolumeEgg";
+import { VILLAGERS, type VillagerId } from "@/utils/villageLife";
+
+export function VillageEgg({
+  size,
+  active,
+  reduceMotion,
+  scarf,
+  asleep = false,
+}: {
+  size: number;
+  active: boolean;
+  reduceMotion: boolean;
+  scarf?: string;
+  asleep?: boolean;
+}) {
+  const zero = useSharedValue(0),
+    blink = useSharedValue(0),
+    breath = useSharedValue(0);
+  useEffect(() => {
+    if (active && !reduceMotion) {
+      breath.value = withRepeat(
+        withSequence(
+          withTiming(1, { duration: 1900 }),
+          withTiming(0, { duration: 2300 }),
+        ),
+        -1,
+      );
+      blink.value = withRepeat(
+        withDelay(
+          3300,
+          withSequence(
+            withTiming(1, { duration: 100 }),
+            withTiming(0, { duration: 130 }),
+          ),
+        ),
+        -1,
+      );
+    }
+    return () => {
+      cancelAnimation(breath);
+      cancelAnimation(blink);
+    };
+  }, [active, reduceMotion, breath, blink]);
+  const style = useAnimatedStyle(() => ({
+    transform: [
+      { scaleX: 1 + breath.value * 0.012 },
+      { scaleY: 1 - breath.value * 0.014 },
+    ],
+  }));
+  return (
+    <Animated.View
+      style={[{ width: size, height: size }, style]}
+      pointerEvents="none"
+    >
+      <VolumeEgg
+        size={size}
+        rx={zero}
+        ry={zero}
+        rz={zero}
+        blink={blink}
+        mood={asleep ? "sleepy" : "happy"}
+      />
+      {scarf && (
+        <Svg
+          width={size}
+          height={size}
+          style={StyleSheet.absoluteFill}
+          viewBox="0 0 100 100"
+        >
+          <Path
+            d="M 21 67 Q 50 81 79 67 L 76 75 Q 50 87 24 75 Z"
+            fill={scarf}
+            stroke="#FFFFFF80"
+            strokeWidth="1.2"
+          />
+          <Path
+            d="M 64 76 Q 69 86 66 94 L 75 94 L 73 74"
+            fill={scarf}
+            stroke="#75678566"
+            strokeWidth="1"
+          />
+        </Svg>
+      )}
+    </Animated.View>
+  );
+}
+export function VillageNeighbors({
+  width,
+  height,
+  active,
+  reduceMotion,
+  onTalk,
+}: {
+  width: number;
+  height: number;
+  active: boolean;
+  reduceMotion: boolean;
+  onTalk: (id: VillagerId) => void;
+}) {
+  return (
+    <>
+      {VILLAGERS.map((n) => (
+        <Pressable
+          key={n.id}
+          testID={`village-neighbor-${n.id}`}
+          accessibilityRole="button"
+          accessibilityLabel={`${n.name}とお話しする`}
+          disabled={!active}
+          onPress={() => onTalk(n.id)}
+          style={{
+            position: "absolute",
+            left: width * n.x - width * 0.062,
+            top: height * n.y - width * 0.11,
+            width: width * 0.124,
+            height: width * 0.145,
