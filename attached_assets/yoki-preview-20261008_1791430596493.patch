+      </Animated.View>
+      <View
+        style={{
+          position: "absolute",
+          left: size * 0.5,
+          top: 0,
+          width: size,
+          // Keep the eyes and mouth above the water; only the lower shell is submerged.
+          height: size * 0.74,
+          overflow: "hidden",
+        }}
+      >
+        <VillageEgg
+          size={size}
+          active={active}
+          reduceMotion={reduceMotion}
+          asleep
+        />
+      </View>
+      <View
+        style={{
+          position: "absolute",
+          top: size * 0.065,
+          left: size * 0.84,
+          width: size * 0.35,
+          height: size * 0.1,
+          borderRadius: 4,
+          backgroundColor: "#DACDE2",
+          borderBottomWidth: 2,
+          borderColor: "#A899B7",
+          transform: [{ rotate: "8deg" }],
+        }}
+      />
+      <Svg
+        width={size * 2}
+        height={size * 0.25}
+        style={{ position: "absolute", top: size * 0.69 }}
+        viewBox="0 0 200 25"
+      >
+        <Ellipse
+          cx="100"
+          cy="7"
+          rx="45"
+          ry="5"
+          fill="#72AA9850"
+          stroke="#F6EDD2B0"
+          strokeWidth="1.5"
+        />
+        <Path
+          d="M 25 13 Q 65 20 110 14 Q 140 9 175 15"
+          fill="none"
+          stroke="#F7E8C975"
+          strokeWidth="1"
+        />
+      </Svg>
+    </View>
+  );
+}
+const s = StyleSheet.create({
+  name: {
+    position: "absolute",
+    bottom: 0,
+    alignSelf: "center",
+    paddingHorizontal: 8,
