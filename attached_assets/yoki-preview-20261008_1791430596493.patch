+}
+/** Waterline covers the lower shell; ripples and towel stay anchored to the bather. */
+export function BathingEgg({
+  width,
+  height,
+  active,
+  reduceMotion,
+}: {
+  width: number;
+  height: number;
+  active: boolean;
+  reduceMotion: boolean;
+}) {
