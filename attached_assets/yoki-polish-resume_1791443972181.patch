+          strokeWidth="4"
+        />
+        {[-2, -1, 0, 1, 2].map((i) => (
+          <Circle
+            key={i}
+            cx={width * (0.5 + i * 0.053)}
+            cy={height * 0.71}
+            r={2}
+            fill="#AF7F66"
+            opacity=".5"
+          />
+        ))}
+        {!frames && (
+          <Path
+            d={
+              "M " +
+              width * 0.5 +
+              " " +
+              height * 0.78 +
+              " Q " +
+              width * 0.5 +
+              " " +
+              height * 0.55 +
+              " " +
+              aimPoint.x +
+              " " +
+              aimPoint.y
+            }
+            stroke="#9A72AF"
