+
+function project(x: number, y: number, width: number, height: number) {
+  "worklet";
+  const q = Math.max(0, Math.min(1.12, y / 10));
+  return {
+    x: width * 0.5 + x * width * (0.405 - q * 0.235),
+    y: height * (0.91 - q * 0.75),
+    scale: 1 - q * 0.52,
+  };
+}
+function Pin({
+  index,
+  width,
+  height,
+  frames,
+  progress,
+}: {
