+++ b/artifacts/mobile/components/world/SatietyGauge.tsx
@@ -0,0 +1,72 @@
+import React from "react";
+import { Pressable, StyleSheet, Text, View } from "react-native";
+import { Icon, iconSize } from "@/components/ui/Icon";
+export function SatietyGauge({
+  value,
+  onPress,
+}: {
+  value: number;
+  onPress?: () => void;
+}) {
+  const amount = Math.max(0, Math.min(100, Math.round(value)));
+  const label =
+    amount < 25
+      ? "おなかぺこぺこ"
+      : amount < 60
+        ? "そろそろごはん"
+        : amount < 85
+          ? "ほどよく満腹"
+          : "おなかいっぱい";
+  const color = amount < 25 ? "#D48865" : amount < 60 ? "#C6A154" : "#7A9F85";
+  return (
+    <Pressable
+      testID="home-satiety"
+      accessibilityRole={onPress ? "button" : "progressbar"}
+      accessibilityLabel={`満腹度${amount}パーセント。${label}`}
+      accessibilityValue={{ min: 0, max: 100, now: amount }}
+      onPress={onPress}
+      style={s.root}
+    >
+      <Icon name="coffee" size={iconSize.sm} color={color} />
+      <View style={s.body}>
+        <View style={s.row}>
+          <Text style={s.name}>{label}</Text>
+          <Text style={s.number}>満腹 {amount}%</Text>
+        </View>
+        <View style={s.track}>
+          <View
+            style={[s.fill, { width: `${amount}%`, backgroundColor: color }]}
+          />
+        </View>
+      </View>
+    </Pressable>
+  );
+}
+const s = StyleSheet.create({
+  root: {
+    minHeight: 44,
+    minWidth: 166,
+    maxWidth: 260,
+    flex: 1,
+    borderRadius: 18,
+    paddingHorizontal: 12,
+    paddingVertical: 8,
+    backgroundColor: "#FFF9F0F2",
+    borderWidth: 1,
+    borderColor: "#FFFFFFE8",
+    flexDirection: "row",
+    alignItems: "center",
+    gap: 9,
+  },
+  body: { flex: 1, gap: 5 },
+  row: { flexDirection: "row", justifyContent: "space-between", gap: 8 },
+  name: { fontSize: 10, color: "#776281", fontWeight: "600" },
+  number: { fontSize: 10, color: "#776281", fontWeight: "700" },
+  track: {
+    height: 5,
+    borderRadius: 4,
+    backgroundColor: "#E9E1E7",
+    overflow: "hidden",
+  },
+  fill: { height: 5, borderRadius: 4 },
+});
