{
  "expo": {
    "name": "YOKI YOKI",
    "slug": "yoki-yoki",
    "owner": "nkgw0703",
    "extra": {
      "eas": {
        "projectId": "fecfbcd8-34e4-46e3-8b82-2f7cfb466434"
      }
    },
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#211137"
    },
    "ios": {
      "bundleIdentifier": "app.replit.yokiyoki--",
      "buildNumber": "19",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleLocalizations": [
          "ja"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "@clerk/expo",
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#211137",
          "image": "./assets/images/splash-empty.png",
          "imageWidth": 1
        }
      ],
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
